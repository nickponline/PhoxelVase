+/// Damage steps shown (each one rebuilds the chunk's group once, so they are few).
+const WEAR_STEPS: f32 = 5.0;
+
+/// How worn a chunk looks: its lost hit points in `WEAR_STEPS` steps. Quantized so steady
+/// damage rebuilds meshes only a few times.
+pub fn wear_level(bd: &rubble_core::Building, c: usize) -> u8 {
+    if bd.glass(c) || bd.hp_max[c] <= 0.0 {
+        return 0;
+    }
+    let lost = (1.0 - bd.hp[c] / bd.hp_max[c]).clamp(0.0, 1.0);
+    (lost * WEAR_STEPS).round() as u8
+}
+
+/// Darken a chunk colour for its wear level: up to 45% for a chunk about to break.
+fn worn(s: [f32; 3], wear: u8) -> [f32; 3] {
+    let lost = wear as f32 / WEAR_STEPS;
+    s.map(|v| v * (1.0 - 0.45 * lost))
+}
